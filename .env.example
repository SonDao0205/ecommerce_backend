# Application
PORT=8080
NODE_ENV=development
FRONTEND_URLS=http://localhost:3000,http://localhost:3001

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=ecommerce_db
DB_LOGGING=true

# JWT Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Cloudinary (chỉ cấu hình tại backend, không đưa API secret sang frontend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
