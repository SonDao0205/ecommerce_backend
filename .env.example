# Application
PORT=8080
NODE_ENV=development
FRONTEND_URLS=http://localhost:3000,http://localhost:3001
# Đặt 1 khi API thực sự đứng sau đúng một reverse proxy/load balancer.
TRUST_PROXY_HOPS=0
HTTP_BODY_LIMIT=1mb
ENABLE_COMPRESSION=true
ENABLE_SWAGGER=true

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=ecommerce_db
DB_LOGGING=true
DB_SYNCHRONIZE=false
DB_POOL_MAX=20
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_POOL_IDLE_TIMEOUT_MS=30000

# Redis cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
STOREFRONT_CATEGORIES_CACHE_TTL_SECONDS=600
DASHBOARD_CACHE_TTL_SECONDS=30

# JWT Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
AUTH_SESSION_CACHE_TTL_SECONDS=60
AUTH_SESSION_REVOKED_TTL_SECONDS=86400

# Cloudinary (chỉ cấu hình tại backend, không đưa API secret sang frontend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SePay Payment Gateway Production
SEPAY_ENV=production
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Có thể để trống nếu IPN dùng cùng SECRET_KEY của merchant.
SEPAY_IPN_SECRET=
SEPAY_CHECKOUT_URL=https://pay.sepay.vn/v1/checkout/init
SEPAY_API_BASE_URL=https://pgapi.sepay.vn
# Domain storefront HTTPS công khai khi kiểm thử IPN/callback thật.
SEPAY_RETURN_BASE_URL=http://localhost:3000
SEPAY_PAYMENT_TTL_SECONDS=900
SEPAY_IPN_MAX_SKEW_SECONDS=900
PAYMENT_EXPIRY_SWEEP_INTERVAL_MS=60000

# Resend transactional email (xác minh domain gửi trước khi dùng production)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=E-Commerce <orders@example.com>
RESEND_REPLY_TO=support@example.com

# Gmail SMTP (đặt EMAIL_PROVIDER=gmail và dùng App Password, không dùng mật khẩu tài khoản)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=E-Commerce
GMAIL_REPLY_TO=
