{
  "info": {
    "_postman_id": "ecommerce-api-collection",
    "name": "Ecommerce API",
    "description": "Postman collection cho toàn bộ endpoints của dự án Ecommerce NestJS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "reset_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Xác thực người dùng – đăng ký, đăng nhập, OTP, đổi mật khẩu, refresh token",
      "item": [
        {
          "name": "Đăng ký tài khoản (CLIENT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Nguyễn Văn A\",\n  \"email\": \"client@example.com\",\n  \"phone\": \"0912345678\",\n  \"password\": \"StrongPass@123\",\n  \"role\": \"CLIENT\"\n}"
            }
          }
        },
        {
          "name": "Đăng ký tài khoản (SELLER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Trần Thị B\",\n  \"email\": \"seller@example.com\",\n  \"phone\": \"0987654321\",\n  \"password\": \"StrongPass@123\",\n  \"role\": \"SELLER\"\n}"
            }
          }
        },
        {
          "name": "Đăng nhập",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.access_token) {",
                  "  pm.collectionVariables.set('access_token', res.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', res.data.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": \"client@example.com\",\n  \"password\": \"StrongPass@123\"\n}"
            }
          }
        },
        {
          "name": "Lấy thông tin người dùng hiện tại (GET /me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Gửi OTP quên mật khẩu",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/forgot-password/otp",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "forgot-password", "otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": \"client@example.com\"\n}"
            }
          }
        },
        {
          "name": "Xác thực OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.reset_token) {",
                  "  pm.collectionVariables.set('reset_token', res.data.reset_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/forgot-password/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "forgot-password", "verify-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": \"client@example.com\",\n  \"otp\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Đặt lại mật khẩu (dùng reset_token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{reset_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/forgot-password/reset",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "forgot-password", "reset"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"NewPass@456\",\n  \"confirmPassword\": \"NewPass@456\"\n}"
            }
          }
        },
        {
          "name": "Đổi mật khẩu (đã đăng nhập)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "change-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"NewPass@456\",\n  \"confirmPassword\": \"NewPass@456\"\n}"
            }
          }
        },
        {
          "name": "Làm mới token (Refresh Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.access_token) {",
                  "  pm.collectionVariables.set('access_token', res.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', res.data.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh-token",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh-token"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        }
      ]
    },
